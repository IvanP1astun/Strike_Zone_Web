# Copy to .env and fill in real values. Never commit .env.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL). Docker Compose sets DB_HOST=db automatically.
POSTGRES_DB=strikezone
POSTGRES_USER=strikezone_user
POSTGRES_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# For quick local development without PostgreSQL uncomment:
# DB_ENGINE=sqlite

# Telegram notifications about new users (optional, leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public address of the site (links in notifications, Telegram webhook)
SITE_URL=

# Telegram notifications for players (optional)
# 1) create a bot in @BotFather, put its token in TELEGRAM_BOT_TOKEN
# 2) TELEGRAM_BOT_USERNAME is the bot name without @
# 3) TELEGRAM_WEBHOOK_SECRET is any long random string
# 4) after deploy run: docker compose exec web python manage.py set_telegram_webhook
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Email notifications (optional; without EMAIL_HOST messages only go to the log)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=StrikeZone <noreply@example.com>

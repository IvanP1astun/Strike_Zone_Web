# Copy to .env and fill in real values. Never commit .env.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL). Docker Compose sets DB_HOST=db automatically.
POSTGRES_DB=strikezone
POSTGRES_USER=strikezone_user
POSTGRES_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# For quick local development without PostgreSQL uncomment:
# DB_ENGINE=sqlite

# Telegram notifications about new users (optional, leave empty to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
